{
  "rules": [
    {
      "id": "no-eval",
      "patterns": [
        {
          "pattern": "eval(...)"
        }
      ],
      "message": "检测到eval()调用，存在代码注入风险",
      "severity": "WARNING"
    },
    {
      "id": "sql-injection",
      "patterns": [
        {
          "pattern": "$(...query...)"
        }
      ],
      "message": "可能存在的SQL注入漏洞",
      "severity": "ERROR"
    },
    {
      "id": "hardcoded-secret",
      "patterns": [
        {
          "pattern": "(password|secret|token|key) = \"...\""
        }
      ],
      "message": "检测到硬编码凭证",
      "severity": "ERROR"
    }
  ]
}
